# FarmStart Backend Configuration
ENVIRONMENT=development
PORT=8000
DATABASE_URL=sqlite:///./farmstart.db

# Groq LLM API Key (fast inference via Groq LPU)
# Get a free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# OpenWeatherMap API Key (optional - Open-Meteo zero-key live meteorology is built-in)
OPENWEATHER_API_KEY=

# Default Region / State
DEFAULT_STATE=Kerala

# data.gov.in / Agmarknet API Key (optional - live scraper & mandi fallback active)
DATA_GOV_IN_API_KEY=
